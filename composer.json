{
    "name": "spectra-php/laravel-spectra",
    "description": "Observability for AI and LLM calls in Laravel. Automatically tracks requests to OpenAI, Anthropic, Gemini, Mistral and 9 more providers, calculates token and media costs, enforces per-user budgets, and ships a real-time dashboard with OpenTelemetry export.",
    "keywords": [
        "laravel",
        "laravel-package",
        "php",
        "ai",
        "llm",
        "observability",
        "llm-observability",
        "llmops",
        "monitoring",
        "opentelemetry",
        "dashboard",
        "cost-tracking",
        "token-usage",
        "openai",
        "anthropic",
        "gemini",
        "mistral",
        "ollama",
        "openrouter",
        "prism"
    ],
    "homepage": "https://github.com/spectra-php/laravel-spectra",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmad Mayahi",
            "email": "ahmad@mayahi.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "symfony/polyfill-php84": "^1.31"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "james-heinrich/getid3": "2.0.x-dev",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1",
        "openai-php/laravel": "^0.22.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^3.0||^4.0||^5.0",
        "pestphp/pest-plugin-arch": "^3.0||^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Spectra\\": "src/",
            "Spectra\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spectra\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "refactor": "vendor/bin/rector process",
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/pint --test",
            "vendor/bin/rector process --dry-run --no-progress-bar",
            "@analyse",
            "npm run typecheck",
            "@test"
        ],
        "pricing-drift": "@php vendor/bin/testbench spectra:pricing-drift",
        "pricing-scrape": "@php vendor/bin/testbench spectra:pricing-scrape --all --path=resources/pricing/catalog.json"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "suggest": {
        "james-heinrich/getid3": "Required for extracting audio duration from TTS binary responses (minute-based cost calculation)",
        "openai-php/laravel": "Lets Spectra track calls made through the OpenAI facade and client (OpenAiWatcher)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spectra\\SpectraServiceProvider"
            ],
            "aliases": {
                "Spectra": "Spectra\\Facades\\Spectra"
            }
        },
        "phpstan/extension-installer": {
            "ignore": [
                "phpstan/phpstan-strict-rules"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
